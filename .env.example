# Copy with scripts/Initialize.ps1: it generates local secrets automatically.
API_PORT=3001
INTERNAL_KEY=replace-with-random-internal-key
JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_DB_PASSWORD=replace-auth-db-password
CUSTOMER_DB_PASSWORD=replace-customer-db-password
ORDER_DB_PASSWORD=replace-order-db-password
PRODUCT_DB_PASSWORD=replace-product-db-password
SHIPMENT_DB_PASSWORD=replace-shipment-db-password
MONGO_REPLICA_KEY=replace-with-long-random-alphanumeric-key
REDIS_PASSWORD=replace-redis-password
JWT_TTL_SECONDS=3600
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_SECONDS=60
# DEMO policy: absent from supplied documents. discount is a money AMOUNT.
DISCOUNT_POLICY=[{"minScore":0,"rate":0},{"minScore":100,"rate":5},{"minScore":500,"rate":10}]
